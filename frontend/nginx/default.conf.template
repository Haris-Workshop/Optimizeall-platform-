# Optimize All web server (rendered by the nginx image's envsubst step into /etc/nginx/conf.d/default.conf).
#
#   ${OA_API_PROXY}   where API requests go, set by 12-optimizeall-platform.envsh from API_UPSTREAM / API_HOSTPORT:
#                     http://optimizeall_api (an upstream block the envsh keeps pointed at the API host's current
#                     addresses, so nginx starts and serves /healthz even while the API host does not resolve), or
#                     API_UPSTREAM itself for an IP literal / https / path  (only defined env vars are substituted)
#   ${IMG_SRC_EXTRA}  extra CSP img-src sources, space separated, e.g. "https://images.example.com"; must list the
#                     same hosts as the API's Content:AllowedImageHosts (default empty: uploaded images only)
#   ${MEDIA_SRC_EXTRA} extra CSP media-src sources for lesson videos hosted elsewhere (e.g. a HeyGen or CDN host),
#                     space separated (default empty: uploaded videos and captions only)
#   ${OA_SSR_PROXY}   the server renderer for pages (server/ssr-server.mjs), set by 12-optimizeall-platform.envsh:
#                     http://127.0.0.1:$SSR_PORT (default 3000), started in this container by 40-optimizeall-ssr.sh
#
# Serves the Vite SPA and reverse-proxies the API on the same origin:
#   /api/     REST API (+ Swagger UI at /api/docs when enabled on the API)
#   /t/       public tracking redirects (/t/{code})
#   /health/  API liveness/readiness
#   /healthz  this nginx container's own health

# Preserve the original scheme when TLS terminates at an outer load balancer that sets X-Forwarded-Proto;
# otherwise use the scheme of the connection nginx received. Only expose this nginx behind a trusted LB or
# directly to clients (in which case a spoofed header can at most mislabel the scheme of a plain-http request).
map $http_x_forwarded_proto $oa_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# HSTS (snippets/security-headers.conf) on HTTPS only: the request reached us over TLS, or the load balancer that
# terminated TLS says so (Render, docs/RENDER.md). Plain-http deployments and local runs get no header (an empty value is
# not sent); a spoofed X-Forwarded-Proto on plain http is harmless, since browsers ignore HSTS received over http.
# One year, without includeSubDomains/preload: other subdomains of a custom domain may still serve plain http.
map $oa_forwarded_proto $oa_hsts {
    default "";
    https   "max-age=31536000";
}

# The host (and port) the visitor used, for X-Forwarded-Host: the Host header as received (with a non-default port, e.g.
# localhost:4173), or the server's own name for requests without one. The API validates it (Common/Hosting/PublicOrigin.cs).
map $http_host $oa_forwarded_host {
    default $http_host;
    ""      $host;
}

# Extra image hosts for the CSP img-src (used in snippets/security-headers.conf, which is not templated).
map "" $oa_img_src_extra {
    default "${IMG_SRC_EXTRA}";
}

# Extra media hosts for the CSP media-src (lesson videos, docs/LEARNING.md).
map "" $oa_media_src_extra {
    default "${MEDIA_SRC_EXTRA}";
}

server {
    # IPv4 only: a hard IPv6 listen fails to start on hosts/runtimes without IPv6.
    listen       8080;
    server_name  _;

    server_tokens off;
    root  /usr/share/nginx/html;
    index index.html;

    # The API enforces per-endpoint limits (screenshots 10 MB, deliverable files up to 50 MB); nginx only caps the
    # largest request so deliverable uploads can reach the API.
    client_max_body_size 55m;

    gzip              on;
    gzip_vary         on;
    gzip_proxied      any;
    gzip_comp_level   5;
    gzip_min_length   1024;
    # HTML is always compressed (nginx's default type); these add the SEO files (sitemaps, feeds, llms.txt, Markdown
    # page versions, JSON-LD) and the other text assets. Brotli would need a module the stock nginx image lacks.
    gzip_types        text/plain text/css text/csv text/markdown text/xml application/javascript application/json
                      application/problem+json application/ld+json application/xml application/rss+xml application/atom+xml
                      image/svg+xml image/x-icon application/manifest+json font/ttf font/otf;

    # ---------------------------------------------------------------- API (same origin)
    # Lecture video uploads to YouTube (docs/YOUTUBE_UPLOAD.md): large bodies, streamed straight to the API (no nginx
    # temp file) with long timeouts. Only this route gets the higher limits; the API enforces YouTube__MaxUploadBytes.
    # A regex location outranks the /api/ prefix below, so it repeats the proxy settings and the 503 mapping.
    location ~ ^/api/v1/admin/learning/courses/[^/]+/lessons/[^/]+/youtube$ {
        client_max_body_size 2100m;
        client_body_timeout 600s;
        proxy_request_buffering off;
        proxy_pass ${OA_API_PROXY};
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        error_page 502 504 =503 @api_unavailable;
    }

    location /api/ {
        proxy_pass ${OA_API_PROXY};
        include /etc/nginx/snippets/proxy-api.conf;
        # CSV exports and batch operations can take longer than the default.
        proxy_read_timeout 120s;
        # API unreachable (starting, restarting, not deployed yet): a JSON 503 instead of nginx's HTML 502. Only
        # nginx's own errors are replaced (proxy_intercept_errors stays off), never the API's responses.
        error_page 502 504 =503 @api_unavailable;
    }

    location @api_unavailable {
        default_type application/problem+json;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "30" always;
        return 503 '{"type":"about:blank","title":"Service unavailable","status":503,"code":"service_unavailable","detail":"The service is starting or restarting. Try again in a few seconds."}';
    }

    location /t/ {
        proxy_pass ${OA_API_PROXY};
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Email tracking: open pixel, click redirect and one-click unsubscribe (RFC 8058). Never cached.
    location /e/ {
        proxy_pass ${OA_API_PROXY};
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }

    location /health/ {
        proxy_pass ${OA_API_PROXY};
        include /etc/nginx/snippets/proxy-api.conf;
        access_log off;
    }

    # ---------------------------------------------------------------- SEO files (docs/SEO_CRO.md)
    # Generated by the API from published content: robots.txt, the sitemap index and sitemaps, llms.txt and
    # llms-full.txt, humans.txt, security.txt and the IndexNow key file (/{key}.txt).
    location = /robots.txt {
        proxy_pass ${OA_API_PROXY};
        include /etc/nginx/snippets/proxy-api.conf;
        include /etc/nginx/snippets/seo-file-errors.conf;
    }

    location = /sitemap.xml {
        proxy_pass ${OA_API_PROXY};
        include /etc/nginx/snippets/proxy-api.conf;
        include /etc/nginx/snippets/seo-file-errors.conf;
    }

    location /sitemaps/ {
        proxy_pass ${OA_API_PROXY};
        include /etc/nginx/snippets/proxy-api.conf;
        include /etc/nginx/snippets/seo-file-errors.conf;
    }

    location ~ "^/(llms\.txt|llms-full\.txt|llms/[a-z0-9-]+\.txt|humans\.txt|\.well-known/security\.txt|[A-Za-z0-9-]{8,128}\.txt)$" {
        proxy_pass ${OA_API_PROXY};
        include /etc/nginx/snippets/proxy-api.conf;
        include /etc/nginx/snippets/seo-file-errors.conf;
    }

    # Generated social cards (Open Graph / Twitter images): /og{page path}.png?v={version}, rendered by the API. A
    # versioned URL is immutable (the API sends a year's max-age); the API's Cache-Control passes through.
    location /og/ {
        proxy_pass ${OA_API_PROXY};
        include /etc/nginx/snippets/proxy-api.conf;
        include /etc/nginx/snippets/seo-file-errors.conf;
        access_log off;
    }

    # Markdown version of every public page for AI assistants: /services/seo.md, /index.md (home).
    location ~ ^/(?!api/|assets/)(.+)\.md$ {
        rewrite ^/(.+)\.md$ /_markdown/$1 break;
        proxy_pass ${OA_API_PROXY};
        include /etc/nginx/snippets/proxy-api.conf;
        include /etc/nginx/snippets/seo-file-errors.conf;
    }

    # Error bodies of the SEO files above (snippets/seo-file-errors.conf keeps the status). "types { }": always text/plain,
    # whatever the extension (.xml, .md).
    location @text_missing {
        types { }
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 200 "Not found.\n";
    }

    location @text_error {
        types { }
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Retry-After "30" always;
        return 200 "This file is not available right now (the service is starting or returned an error). Try again in a few seconds.\n";
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---------------------------------------------------------------- SPA
    # Vite emits content-hashed files under /assets/: cache forever, never fall back to index.html.
    location /assets/ {
        # Source maps are never served: the build does not emit them, and this also covers a build that did.
        location ~* \.map$ {
            access_log off;
            return 404;
        }
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    # The app shell must always be revalidated so new deployments are picked up immediately. It duplicates the home
    # page, so it is never indexed itself.
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        add_header X-Robots-Tag "noindex" always;
    }

    # The shell fragments the API's documents include (built by the seoShell Vite plugin); never served directly.
    location /__shell/ {
        internal;
    }

    # The build manifest (read by the server renderer) is not a page or an asset.
    location /.vite/ {
        return 404;
    }

    # Signed-in portals and sign-in pages: the plain app shell, never indexed (robots.txt disallows them too).
    location ~ ^/(app|admin|agency|client|review|finance|manage|login|register|check-email|verify-email|forgot-password|reset-password|auth|design-system)(/|$) {
        try_files /index.html =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # Static files from the build (favicon, icons, manifest, /media/ videos) get a short cache; every other path is a
    # page, rendered by the API (below). This is the only fallback for public paths: @document also answers moved public
    # addresses (Website → Redirects, docs/WEBSITE.md) with their real 301, so no separate redirect lookup runs first.
    location / {
        try_files $uri @document;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=3600" always;
    }

    location = /site.webmanifest {
        types { }
        default_type application/manifest+json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
    }

    location /media/ {
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=604800" always;
        access_log off;
    }

    # Server-rendered pages (docs/SEO_CRO.md § Rendering): the API answers /_document{path} with the page's status
    # (200 / 301 for URL normalization and managed redirects / 404 / 410), SEO head, JSON-LD and crawlable content, and two SSI includes that pull in the app shell
    # (/__shell/head.html, /__shell/body.html) so the React app boots over it. If the API is unreachable, visitors
    # still get the app (with 503, so crawlers come back later instead of indexing an empty shell).
    #
    # Pages go through the server renderer first (${OA_SSR_PROXY}: server/ssr-server.mjs in this container, started by
    # 40-optimizeall-ssr.sh): it fetches the same /_document URL from the API and, for public website pages, puts the
    # React app's own markup, stylesheets and data into it, so the designed page paints before any JavaScript runs and
    # the browser hydrates it. Statuses, redirects and the SEO head stay the API's. If the renderer is not running
    # (502) or does not answer in time (504), the API is asked directly (@document_api): the page is then rendered in
    # the browser, as without SSR.
    location @document {
        rewrite ^ /_document$uri break;
        proxy_pass ${OA_SSR_PROXY};
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_read_timeout 40s;
        error_page 502 504 = @document_api;
        include /etc/nginx/snippets/document.conf;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location @document_api {
        # The URI is already /_document{path} when the renderer failed; a direct hit would not be.
        rewrite ^(?!/_document)(.*)$ /_document$1 break;
        proxy_pass ${OA_API_PROXY};
        include /etc/nginx/snippets/proxy-api.conf;
        error_page 502 504 =503 @shell;
        include /etc/nginx/snippets/document.conf;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location @shell {
        try_files /index.html =404;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "30" always;
    }
}
